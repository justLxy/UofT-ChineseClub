generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 活动模型
model Event {
  id             Int       @id @default(autoincrement()) /// 活动ID
  title_en       String /// 英文标题
  title_zh       String /// 中文标题
  description_en String /// 英文描述
  description_zh String /// 中文描述
  imageUrl       String? /// 活动图片URL
  startDate      DateTime /// 开始日期
  endDate        DateTime? /// 结束日期
  location_en    String? /// 英文地点
  location_zh    String? /// 中文地点
  status         String /// 活动状态 (e.g., upcoming, ongoing, past)
  createdAt      DateTime  @default(now()) /// 创建时间
  updatedAt      DateTime  @updatedAt /// 更新时间
  link           String? /// 相关链接
  featured       Boolean   @default(false) /// 是否为精选活动
}

/// 员工/成员模型
model Staff {
  id                Int           @id @default(autoincrement()) /// 用户ID
  username          String        @unique /// 用户名
  email             String        @unique /// 邮箱
  passwordHash      String /// 加密后的密码
  isActive          Boolean       @default(true) /// 账号是否激活
  role              String        @default("staff") /// 角色 (staff, admin)
  isEmailVerified   Boolean       @default(false) /// 邮箱是否已验证
  canManageEvents   Boolean       @default(false) /// 是否有权限管理活动
  canReviewProfiles Boolean       @default(false) /// 是否有权限审核资料
  canManageStaff    Boolean       @default(false) /// 是否有权限管理成员
  createdAt         DateTime      @default(now()) /// 创建时间
  updatedAt         DateTime      @updatedAt /// 更新时间
  lastLogin         DateTime? /// 上次登录时间
  profile           StaffProfile? /// 关联的个人资料
}

/// 成员个人资料模型
model StaffProfile {
  id           Int       @id @default(autoincrement()) /// 资料ID
  staffId      Int       @unique /// 关联的Staff ID
  name_en      String /// 英文姓名
  name_zh      String /// 中文姓名
  position_en  String /// 英文职位
  position_zh  String /// 中文职位
  department   String /// 所属部门
  bio_en       String? /// 英文简介
  bio_zh       String? /// 中文简介
  avatarUrl    String? /// 头像URL
  email        String? /// 公开联系邮箱
  linkedin     String? /// LinkedIn链接
  github       String? /// GitHub链接
  wechat       String? /// 微信号
  phone        String? /// 电话
  mbti         String? /// MBTI类型
  status       String    @default("pending") /// 资料审核状态 (pending, approved, rejected)
  reviewedAt   DateTime? /// 审核时间
  reviewedBy   String? /// 审核人
  reviewNote   String? /// 审核意见
  displayOrder Int       @default(0) /// 显示顺序
  isVisible    Boolean   @default(false) /// 是否在团队页面可见
  createdAt    DateTime  @default(now()) /// 创建时间
  updatedAt    DateTime  @updatedAt /// 更新时间
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade) /// 关联的Staff
}

/// 成员资料修改历史模型
model StaffProfileHistory {
  id          Int      @id @default(autoincrement()) /// 历史记录ID
  staffId     Int /// 关联的Staff ID
  profileData String /// 资料快照 (JSON 格式)
  action      String /// 操作类型 (e.g., created, updated, status_changed)
  actionBy    String? /// 操作人
  actionNote  String? /// 操作备注
  createdAt   DateTime @default(now()) /// 创建时间
}

/// 邮箱验证码模型
model VerificationCode {
  id         Int      @id @default(autoincrement()) /// 记录ID
  email      String   @unique /// 接收验证码的邮箱地址
  code       String /// 验证码
  expiresAt  DateTime /// 过期时间
  attempts   Int      @default(0) /// 尝试次数
  lastSentAt DateTime @default(now()) /// 上次发送时间
  createdAt  DateTime @default(now()) /// 创建时间
  updatedAt  DateTime @updatedAt /// 更新时间
}
