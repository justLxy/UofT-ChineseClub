generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             Int       @id @default(autoincrement())
  title_en       String
  title_zh       String
  description_en String
  description_zh String
  imageUrl       String?
  startDate      DateTime
  endDate        DateTime?
  location_en    String?
  location_zh    String?
  status         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  link           String?
  featured       Boolean   @default(false)
}

model Staff {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  email             String        @unique
  passwordHash      String
  isActive          Boolean       @default(true)
  role              String        @default("staff")
  isEmailVerified   Boolean       @default(false)
  canManageEvents   Boolean       @default(false)
  canReviewProfiles Boolean       @default(false)
  canManageStaff    Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lastLogin         DateTime?
  profile           StaffProfile?
}

model StaffProfile {
  id           Int       @id @default(autoincrement())
  staffId      Int       @unique
  name_en      String
  name_zh      String
  position_en  String
  position_zh  String
  department   String
  bio_en       String?
  bio_zh       String?
  avatarUrl    String?
  email        String?
  linkedin     String?
  github       String?
  wechat       String?
  phone        String?
  mbti         String?
  status       String    @default("pending")
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewNote   String?
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffProfileHistory {
  id          Int      @id @default(autoincrement())
  staffId     Int
  profileData String
  action      String
  actionBy    String?
  actionNote  String?
  createdAt   DateTime @default(now())
}

model VerificationCode {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
